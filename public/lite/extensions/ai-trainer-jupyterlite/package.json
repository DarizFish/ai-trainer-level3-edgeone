{
  "name": "ai-trainer-jupyterlite",
  "version": "1.0.0",
  "private": true,
  "description": "JupyterLite bridge for the AI Trainer Level 3 preparation site",
  "license": "UNLICENSED",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{js,d.ts,js.map}"
  ],
  "scripts": {
    "build:lib": "tsc -b",
    "build:extension": "build-labextension . --core-path ../public/lite/lab && node normalize-build.mjs",
    "build": "npm run build:lib && npm run build:extension"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "sharedPackages": {
      "@jupyterlite/services": {
        "bundled": false,
        "singleton": true
      }
    },
    "_build": {
      "load": "static/remoteEntry.4cd89be5be718073c526.js",
      "extension": "./extension"
    }
  },
  "dependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@jupyterlab/application": "^4.6.0",
    "@jupyterlab/apputils": "^4.7.0",
    "@jupyterlab/notebook": "^4.6.0",
    "@jupyterlite/services": "0.8.1"
  },
  "devDependencies": {
    "@jupyterlab/builder": "4.5.9",
    "typescript": "5.9.3"
  }
}
