DATABASE_URL=postgresql://postgres.example:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# EdgeOne keeps the conservative one-connection default. A persistent Node
# process can raise this gradually after observing real concurrency.
DATABASE_POOL_MAX=1
# EdgeOne: eo-connecting-ip. Self-hosted Nginx: x-real-ip.
TRUSTED_CLIENT_IP_HEADER=eo-connecting-ip
