{
  "name": "ai-trainer-level3-edgeone",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/generate-public-content.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-public-content.mjs",
    "build": "next build --webpack",
    "package:self-hosted": "node scripts/package-self-hosted.mjs",
    "build:self-hosted": "npm run build && npm run package:self-hosted",
    "start": "next start",
    "test": "npm run test:quick",
    "test:contracts": "node --test tests/contracts.test.mjs tests/practical-requirements.test.mjs tests/publish-theory-review.test.mjs tests/theory-review-state.test.mjs",
    "test:quick": "npm run lint && npm run typecheck && npm run content:validate && npm run test:contracts",
    "test:build": "npm run build",
    "test:browser": "playwright test",
    "test:full": "npm run test:quick && npm run test:build && npm run test:browser",
    "test:ci": "npm run test:full",
    "test:smoke": "node --test tests/production-smoke.test.mjs",
    "test:install-browser": "playwright install --no-shell chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern tmp --ignore-pattern public/lite --ignore-pattern public/labs/runtime --ignore-pattern .jupyterlite-venv --ignore-pattern jupyterlite/.cache --ignore-pattern jupyterlite-extension/.core --ignore-pattern jupyterlite-extension/lib --ignore-pattern jupyterlite-extension/labextension",
    "db:generate": "drizzle-kit generate",
    "db:baseline": "node scripts/manage-database.mjs baseline",
    "db:check": "node scripts/manage-database.mjs check",
    "db:migrate": "node scripts/manage-database.mjs migrate",
    "content:import": "python scripts/import-reference.py",
    "content:reference:snapshot": "python scripts/theory_reference.py snapshot",
    "content:reference:apply": "python scripts/theory_reference.py apply",
    "content:theory-review:validate": "python scripts/theory_review_state.py validate && python scripts/theory_review_quality.py --require-complete",
    "content:theory-review:publish": "python scripts/publish_theory_review.py",
    "content:theory-review:restamp": "python scripts/publish_theory_review.py --restamp",
    "content:notebook-solutions:snapshot": "python scripts/notebook_solutions.py snapshot",
    "content:notebook-solutions:apply": "python scripts/notebook_solutions.py apply",
    "content:practical-materials": "python scripts/sync-practical-materials.py",
    "content:validate": "python scripts/validate-content.py",
    "og:build": "node scripts/build-og-image.mjs",
    "labs:quantize": "python scripts/quantize-browser-models.py",
    "labs:prepare": "python scripts/prepare-lab-assets.py",
    "labs:runtime": "node scripts/copy-onnxruntime-web.mjs",
    "jupyterlite:notebooks": "python scripts/generate-jupyterlite-notebooks.py",
    "jupyterlite:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-jupyterlite-extension.ps1",
    "jupyterlite:patch": "python scripts/patch-jupyterlite-config.py",
    "jupyterlite:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-jupyterlite.ps1"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jupyter-iframe-commands-host": "0.3.0",
    "next": "16.3.0",
    "onnxruntime-web": "1.27.0",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sanitize-html": "2.17.6"
  },
  "type": "module"
}
