page{background:#f6f4ed;color:#25382f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,text,input,textarea,button{box-sizing:border-box}button{font-size:28rpx;border-radius:14rpx;margin:0}button::after{border:0}button[disabled]{opacity:.5}button.primary{background:#245946;color:#fffef9}button.secondary{background:#e8ede5;color:#245946}button.quiet{background:transparent;color:#245946;border:1rpx solid #cfd6cb}button.danger{background:#f6e5df;color:#97402e}.page{padding:36rpx 30rpx 64rpx}.eyebrow{font-size:21rpx;letter-spacing:4rpx;color:#77836f;margin-bottom:12rpx}.title{font-size:48rpx;font-weight:700;line-height:1.3;letter-spacing:-1rpx}.subtitle{font-size:26rpx;color:#69756d;margin-top:16rpx}.section-title{font-size:32rpx;font-weight:650;margin:34rpx 0 20rpx}.card{padding:28rpx;background:#fffef9;border:1rpx solid #e3e4d9;border-radius:22rpx;margin-bottom:22rpx}.hero{background:#245946;color:#fffef9}.hero .eyebrow,.hero .subtitle{color:#d1ddc8}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.muted{color:#788075;font-size:24rpx}.small{font-size:24rpx}.stat{font-size:50rpx;font-weight:700;line-height:1.2}.tag{display:inline-block;font-size:22rpx;padding:5rpx 14rpx;border-radius:8rpx;background:#eef0e6;color:#506c53}.pill{padding:13rpx 24rpx;border-radius:40rpx;background:#e9ece2;white-space:nowrap;display:inline-block;margin-right:12rpx;font-size:25rpx}.pill.active{background:#245946;color:white}.filters{white-space:nowrap;margin:22rpx 0}.notice{padding:20rpx 24rpx;border-radius:12rpx;background:#eeebda;color:#756740;font-size:24rpx;margin:18rpx 0;white-space:pre-wrap}.error{color:#97402e;background:#f6e5df}.empty{text-align:center;padding:70rpx 30rpx;color:#778075}.actions{display:flex;gap:16rpx;margin-top:24rpx}.actions button{flex:1}.input{width:100%;background:#fffef9;border:1rpx solid #cbd3c5;border-radius:12rpx;padding:20rpx;margin:12rpx 0 24rpx;min-height:88rpx;font-size:28rpx}.label{font-size:26rpx;font-weight:600}.bar{height:10rpx;background:#e6ebdf;border-radius:10rpx;margin-top:16rpx;overflow:hidden}.bar-fill{height:100%;background:#61866d;border-radius:10rpx}.link{color:#245946;font-weight:600}.divider{height:1rpx;background:#e4e7db;margin:24rpx 0}.pre{white-space:pre-wrap;word-break:break-word}.number{font-family:Georgia,serif;font-size:44rpx;color:#829175}.bottom{padding:24rpx 0 env(safe-area-inset-bottom)}
