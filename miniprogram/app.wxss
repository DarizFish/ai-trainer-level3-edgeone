page{--paper:#f4efe3;--paper-deep:#e9dfca;--card:#fffdf7;--ink:#102a43;--ink-soft:#3e5365;--red:#b23a2b;--red-dark:#8e2d23;--gold:#b18a43;--line:rgba(16,42,67,.17);--success:#2d6b4c;background:var(--paper);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.65}
view,text,input,textarea,button{box-sizing:border-box}button{font-size:28rpx;border-radius:6rpx;margin:0}button::after{border:0}button[disabled]{opacity:.45}button.primary{background:var(--red);color:var(--card)}button.secondary{background:var(--paper-deep);color:var(--ink)}button.quiet{background:transparent;color:var(--ink);border:1rpx solid var(--line)}button.danger{background:#f6e5df;color:var(--red-dark)}
.page{padding:36rpx 30rpx 64rpx}.eyebrow{font-size:21rpx;letter-spacing:4rpx;color:var(--red);margin-bottom:12rpx}.title{font-family:"Noto Serif SC",STSong,SimSun,serif;font-size:48rpx;font-weight:700;line-height:1.3;letter-spacing:-1rpx}.subtitle{font-size:26rpx;color:var(--ink-soft);margin-top:16rpx}.section-title{font-family:"Noto Serif SC",STSong,SimSun,serif;font-size:32rpx;font-weight:700;margin:34rpx 0 20rpx}
.card{padding:28rpx;background:var(--card);border:1rpx solid var(--line);border-radius:8rpx;margin-bottom:22rpx}.hero{background:var(--ink);color:var(--card)}.hero .eyebrow,.hero .subtitle{color:#ced9e1}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.muted{color:var(--ink-soft);font-size:24rpx}.small{font-size:24rpx}.stat{font-family:Georgia,serif;font-size:50rpx;font-weight:700;line-height:1.2}.tag{display:inline-block;font-size:22rpx;padding:5rpx 14rpx;border-radius:4rpx;background:var(--paper-deep);color:var(--ink-soft)}
.pill{padding:13rpx 24rpx;border-radius:6rpx;background:var(--paper-deep);white-space:nowrap;display:inline-block;margin-right:12rpx;font-size:25rpx}.pill.active{background:var(--red);color:white}.filters{white-space:nowrap;margin:22rpx 0}.notice{padding:20rpx 24rpx;border-radius:6rpx;background:var(--paper-deep);color:var(--ink-soft);font-size:24rpx;margin:18rpx 0;white-space:pre-wrap}.error{color:var(--red-dark);background:#f6e5df}.empty{text-align:center;padding:70rpx 30rpx;color:var(--ink-soft)}.actions{display:flex;gap:16rpx;margin-top:24rpx}.actions button{flex:1}.input{width:100%;background:var(--card);border:1rpx solid var(--line);border-radius:6rpx;padding:20rpx;margin:12rpx 0 24rpx;min-height:88rpx;font-size:28rpx}.label{font-size:26rpx;font-weight:600}.bar{height:8rpx;background:var(--paper-deep);border-radius:0;margin-top:16rpx;overflow:hidden}.bar-fill{height:100%;background:var(--red)}.link{color:var(--red);font-weight:600}.divider{height:1rpx;background:var(--line);margin:24rpx 0}.pre{white-space:pre-wrap;word-break:break-word}.number{font-family:Georgia,serif;font-size:44rpx;color:var(--red)}.bottom{padding:24rpx 0 env(safe-area-inset-bottom)}
