:host{font-family:-apple-system,"PingFang SC",sans-serif}.guide-mask{position:fixed;z-index:80;inset:0;display:flex;align-items:flex-end;background:rgba(16,42,67,.45)}.guide{width:100%;max-height:90vh;overflow:auto;padding-bottom:env(safe-area-inset-bottom);background:var(--card,#fffdf7);border-radius:8px 8px 0 0;color:var(--ink,#102a43);box-sizing:border-box}.guide button{display:flex;justify-content:center;align-items:center;min-height:44px;min-width:44px;margin:0;font-size:14px;line-height:1.4;border-radius:3px}.guide button::after{border:0}.guide-heading{display:flex;align-items:center;justify-content:space-between;padding:5px 14px;border-bottom:1px solid var(--line,#d6d5cc);font-size:15px;font-weight:600}.guide-heading button{background:transparent;font-size:25px;color:var(--ink-soft,#3e5365)}.guide-body{padding:22px 22px 26px}.guide-title{font-size:22px;font-family:"Noto Serif SC",STSong,SimSun,serif;font-weight:700;line-height:1.5}.guide-subtitle{margin-top:8px;font-size:13px;line-height:1.8;color:var(--ink-soft,#3e5365)}.guide-steps{margin:22px 0;font-size:13px;line-height:1.8}.guide-steps view+view{margin-top:12px}.guide-steps text{color:var(--red,#b23a2b);font-family:Georgia,serif;font-weight:700;margin-right:9px}.guide-url{padding:12px;background:var(--paper,#f4efe3);border:1px solid var(--line,#d6d5cc);font-size:12px;line-height:1.7;word-break:break-all}.guide .copy-link{width:100%;margin-top:16px;background:var(--red,#b23a2b);color:white;font-weight:600}.guide-note{margin-top:15px;color:var(--ink-soft,#3e5365);font-size:11px;line-height:1.8}
