:host{display:block;white-space:normal}.comparison{display:flex;align-items:baseline;gap:6px;box-sizing:border-box;margin:4px 0 6px;padding:5px 7px;border:1px solid #decba1;border-left:3px solid #b59b60;border-radius:4px;background:#fff2d5;font-family:-apple-system,"PingFang SC",sans-serif;font-size:12px;line-height:22px;color:#212121}.verdict{flex-shrink:0;font-size:10px;font-weight:600;color:#757575}.exact{border-left-color:#2e7d32}.exact .verdict{color:#2e7d32}.different{border-left-color:#d32f2f}.different .verdict{color:#d32f2f}.answer-label{flex-shrink:0;font-size:10px;color:#616161}.reference{flex:1;min-width:0;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;font-family:Consolas,Menlo,"PingFang SC",monospace;font-size:12px}.changed{color:#b71c1c;background:#ffebee}
