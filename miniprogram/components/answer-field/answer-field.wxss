:host{display:block}.field{padding:18px 0}.label{font-size:16px;font-weight:600;line-height:1.6;color:#25382f;margin-bottom:10px}.mastered{font-size:11px;color:#4f785a;margin-left:10px;font-weight:400}button.answer-preview{display:flex;align-items:flex-start;justify-content:space-between;box-sizing:border-box;width:100%;min-width:0;min-height:64px;margin:0;padding:14px 12px;background:#f2f5ed;border:1px dashed #b6c6ad;border-radius:8px;text-align:left;font-size:15px;font-weight:400;line-height:1.75;color:#6c7b65}button.answer-preview::after{border:0}.has-answer{background:#f7f8f2!important;border-style:solid!important;color:#263c2f!important}.preview-text{flex:1;min-width:0;white-space:pre-wrap;word-break:break-word;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.edit-mark{font-size:12px;margin-left:12px;color:#527545;flex-shrink:0}
