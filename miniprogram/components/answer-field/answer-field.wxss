:host{display:block}.field{padding:18px 0}.label{font-size:16px;font-weight:600;line-height:1.6;color:var(--ink);margin-bottom:10px}.mastered{font-size:11px;color:var(--success);margin-left:10px;font-weight:400}button.answer-preview{display:flex;align-items:flex-start;justify-content:space-between;box-sizing:border-box;width:100%;min-width:0;min-height:64px;margin:0;padding:14px 12px;background:var(--paper);border:1px dashed var(--line);border-radius:8px;text-align:left;font-size:15px;font-weight:400;line-height:1.75;color:var(--ink-soft)}button.answer-preview::after{border:0}.has-answer{background:var(--card)!important;border-style:solid!important;color:var(--ink)!important}.preview-text{flex:1;min-width:0;white-space:pre-wrap;word-break:break-word;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.edit-mark{font-size:12px;margin-left:12px;color:var(--red);flex-shrink:0}
:host{color:var(--ink)}.field-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}.field-heading .label{flex:1;min-width:0}.field-heading button.compare-field{flex:0 0 68px;width:68px;min-height:44px;margin:-8px 0 0;padding:0;font-size:12px;line-height:1.4;background:transparent;color:var(--red);font-weight:600;display:flex;align-items:center;justify-content:center}.field-heading button::after{border:0}
