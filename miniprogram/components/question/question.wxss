.meta{font-size:24rpx;color:#778075;margin-bottom:18rpx}.stem{font-size:32rpx;line-height:1.75;font-weight:600;margin-bottom:28rpx;white-space:pre-wrap}.option{display:flex;align-items:flex-start;text-align:left;gap:18rpx;width:100%;padding:22rpx;margin-bottom:16rpx;background:#fffef9;border:2rpx solid #e0e5d9;border-radius:14rpx;font-size:28rpx;line-height:1.6;color:#2c3b32}.option::after{border:0}.chosen{border-color:#547e63;background:#eaf0e5}.correct{border-color:#548565;background:#e4efe1}.wrong{border-color:#c48870;background:#f5e9e1}.letter{font-weight:700;min-width:34rpx}.option-text{flex:1}.explanation{padding:24rpx;background:#ecf0e5;border-radius:14rpx;font-size:26rpx;line-height:1.8;white-space:pre-wrap}.answer{font-weight:650;margin-bottom:12rpx}
button.option{display:flex;justify-content:flex-start;width:100%;margin-left:0;margin-right:0;min-height:96rpx;text-align:left;box-sizing:border-box}.option-text{display:block;text-align:left;min-width:0;white-space:normal;word-break:break-word}.letter,.choice-mark{flex-shrink:0;text-align:left}.letter{width:34rpx}
