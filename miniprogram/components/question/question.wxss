.meta{font-size:24rpx;color:var(--ink-soft);margin-bottom:18rpx}.stem{font-size:32rpx;line-height:1.75;font-weight:600;margin-bottom:28rpx;white-space:pre-wrap}.option{display:flex;align-items:flex-start;text-align:left;gap:18rpx;width:100%;padding:22rpx;margin-bottom:16rpx;background:var(--card);border:2rpx solid var(--line);border-radius:14rpx;font-size:28rpx;line-height:1.6;color:var(--ink)}.option::after{border:0}.chosen{border-color:var(--red);background:#f4e3d8}.correct{border-color:#548565;background:#e4efe1}.wrong{border-color:var(--red);background:#f6e5df}.letter{font-weight:700;min-width:34rpx}.option-text{flex:1}.explanation{padding:24rpx;background:var(--paper);border-radius:14rpx;font-size:26rpx;line-height:1.8;white-space:pre-wrap}.answer{font-weight:650;margin-bottom:12rpx}
button.option{display:flex;justify-content:flex-start;width:100%;margin-left:0;margin-right:0;min-height:96rpx;text-align:left;box-sizing:border-box}.option-text{display:block;text-align:left;min-width:0;white-space:normal;word-break:break-word}.letter,.choice-mark{flex-shrink:0;text-align:left}.letter{width:34rpx}
