<view class="page"><view class="eyebrow">你的学习档案</view><view class="title">{{session ? session.displayName : '你好，备考者'}}</view><view class="subtitle">{{session ? session.email : '登录后同步理论学习记录与模考成绩。'}}</view>
  <button wx:if="{{!session || session.expired}}" class="primary" style="margin-top:24rpx" bindtap="login" data-action="login">{{session ? '会话已过期，重新登录' : '登录 / 注册'}}</button>
  <view class="section-title">理论学习进度</view><view wx:for="{{stats}}" wx:key="type" class="card"><view class="row"><text>{{item.label}}</text><text>{{item.answered}} / {{item.total}}</text></view><view class="bar"><view class="bar-fill" style="width:{{item.answered/item.total*100}}%"></view></view></view>
  <view class="card"><view class="row"><text class="label">{{session ? '账号同步' : '本机学习'}}</text><text class="tag">{{pending ? pending + ' 条待同步' : '无待同步记录'}}</text></view><view class="muted" style="margin-top:14rpx">题库 {{version}} · 实操填写仅保存在本机</view><view wx:if="{{error}}" class="notice error">{{error}}</view><button class="secondary" style="margin-top:20rpx" bindtap="sync" data-action="sync" loading="{{busy}}" disabled="{{busy}}">刷新题库与学习记录</button></view>
  <view wx:if="{{held.length}}" class="notice" bindtap="held" data-action="held">{{held.length}} 批记录未被服务器接收，已留存本机，不影响后续同步。点击查看。</view>
  <block wx:if="{{showHeld}}"><view wx:for="{{held}}" wx:key="id" class="card small pre"><view>{{item.reason}}</view><view>{{item.summary}}</view></view></block>
  <view wx:if="{{session}}" class="section-title">云端模考成绩</view><view wx:for="{{history}}" wx:key="id" class="card row"><view>{{item.mode}}<view class="muted">{{item.date}}</view></view><text class="stat">{{item.score}}</text></view><view wx:if="{{session && !history.length}}" class="muted">完成考试并同步后，成绩会显示在这里。本机试卷可到模考页复盘。</view>
  <view class="card row" style="margin-top:28rpx" bindtap="privacy" data-action="privacy"><text>隐私说明与使用条款</text><text>→</text></view><button wx:if="{{session}}" class="quiet" bindtap="logout" data-action="logout">退出当前账号</button>
</view>
