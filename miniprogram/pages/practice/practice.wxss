.practice-page{padding-bottom:calc(260rpx + env(safe-area-inset-bottom))}.answer-hint{font-size:24rpx;color:var(--ink-soft);margin:22rpx 0}.practice-toolbar{position:fixed;bottom:0;left:0;right:0;padding:18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));background:var(--card);border-top:1rpx solid var(--line);z-index:10}.toolbar-row{display:flex;gap:14rpx}.toolbar-row button{flex:1;min-width:0;min-height:96rpx;display:flex;align-items:center;justify-content:center;padding:12rpx;font-size:27rpx;line-height:1.4}.favorite{background:var(--paper-deep);color:var(--ink-soft)}.favorite.is-favorite{background:var(--paper-deep);color:var(--red)}.confirm{margin-bottom:16rpx;width:100%}
.history-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:14rpx 0;color:var(--ink-soft);font-size:25rpx}.history-row button{width:auto!important;min-width:0;margin:0;padding:10rpx 18rpx;min-height:84rpx;display:flex;align-items:center;justify-content:center;background:var(--paper-deep);color:var(--red);font-size:25rpx;line-height:1.4;flex-shrink:0}
