.practice-page{padding-bottom:calc(260rpx + env(safe-area-inset-bottom))}.answer-hint{font-size:24rpx;color:#69756d;margin:22rpx 0}.practice-toolbar{position:fixed;bottom:0;left:0;right:0;padding:18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));background:#fffef9;border-top:1rpx solid #dce1d5;z-index:10}.toolbar-row{display:flex;gap:14rpx}.toolbar-row button{flex:1;min-width:0;min-height:96rpx;display:flex;align-items:center;justify-content:center;padding:12rpx;font-size:27rpx;line-height:1.4}.favorite{background:#eef0e6;color:#53634c}.favorite.is-favorite{background:#e4edda;color:#245946}.confirm{margin-bottom:16rpx;width:100%}
.history-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:14rpx 0;color:#53684b;font-size:25rpx}.history-row button{width:auto!important;min-width:0;margin:0;padding:10rpx 18rpx;min-height:84rpx;display:flex;align-items:center;justify-content:center;background:#e8ede5;color:#245946;font-size:25rpx;line-height:1.4;flex-shrink:0}
