page{background:var(--card);overflow:hidden}
.workspace{display:flex;flex-direction:column;width:100%;box-sizing:border-box;overflow:hidden;position:relative;background:var(--card);color:var(--ink)}
.workspace button{box-sizing:border-box;min-width:0;margin:0;border-radius:0;font-size:14px;font-weight:500;line-height:1.4;background:transparent;padding:0;color:inherit}
.workspace button::after{border:0}
.workspace-top{height:44px;min-height:44px;display:flex;align-items:center;justify-content:space-between;background:var(--card);border-bottom:1px solid var(--line);padding:0 6px}
.top-action{height:44px;min-width:52px!important}
.mode-switch{display:flex;align-items:center;gap:2px;background:var(--paper-deep);border-radius:7px;padding:3px}
.mode-switch button{height:32px;min-width:76px;padding:0 12px;border-radius:5px;color:var(--ink-soft)}
.mode-switch .selected{background:var(--card);color:var(--red);font-weight:600}
.mode-label{font-size:14px;color:var(--ink-soft)}
.reader{flex:1;height:0;min-height:0;width:100%;box-sizing:border-box}
.code-reader{background:#f5f5f5;color:#212121}
.code-content{padding:12px 0 30px;box-sizing:border-box;font-family:Consolas,Menlo,monospace;font-size:14px;line-height:25px}
.code-line{display:flex;align-items:flex-start;min-height:25px;border-left:3px solid transparent;padding-right:12px}
.code-line.current-line{border-left-color:#2196f3;background:#fff}
.line-number{width:35px;min-width:35px;box-sizing:border-box;flex-shrink:0;text-align:right;padding-right:10px;color:#9e9e9e;font-size:11px;line-height:25px;user-select:none}
.line-content{min-width:0;flex:1;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word}
.code-text{white-space:pre-wrap}
.code-blank{display:inline-block;position:relative;box-sizing:border-box;min-width:64px;min-height:44px;max-width:100%;padding:7px 5px;margin:2px;white-space:pre-wrap;vertical-align:middle;background:transparent;color:#212121;font-size:14px;line-height:26px;word-break:break-word}
.code-blank::after{content:"";position:absolute;left:4px;right:4px;bottom:7px;height:1px;background:#bdbdbd;pointer-events:none}
.code-blank.active-blank::after{height:2px;background:#2196f3}
.filled-blank{color:#212121}
.unwrapped .code-content{display:inline-block;min-width:100%}
.unwrapped .line-content,.unwrapped .code-text,.unwrapped .code-blank{white-space:pre}
.unwrapped .code-line{min-width:max-content}
.cell-heading{padding:10px 14px;margin:12px 0 8px;font-size:13px;line-height:1.7;color:#616161;background:#eee;font-family:-apple-system,sans-serif}
.reader-footer{height:52px;min-height:52px;display:flex;align-items:center;gap:10px;padding:0 14px;border-top:1px solid var(--line);background:var(--card)}
.completion{font-size:13px;color:var(--ink-soft);flex:1;white-space:nowrap}
.fill-toolbar{flex-shrink:0;display:flex;align-items:center;height:44px;padding:0 10px;background:var(--card);border-top:1px solid var(--line)}
.fill-toolbar button{height:44px;min-width:44px}
.fill-toolbar button[data-step]{font-size:26px;color:var(--ink)}
.position{font-size:12px;color:var(--ink-soft);min-width:48px;text-align:center}
.fill-toolbar .reference-action{margin-left:auto;min-width:84px;color:var(--red);font-weight:600}
.fill-toolbar .done-action{min-width:62px;color:var(--red);font-weight:650}
.inline-editor{display:block;box-sizing:border-box;width:100%;min-height:24px;padding:0;margin:0;font-size:14px;line-height:24px;color:inherit;white-space:pre-wrap;word-break:break-word}
.template-answer{font-size:16px;line-height:30px;min-height:30px}
.code-answer{font-family:Consolas,Menlo,"PingFang SC","Microsoft YaHei",monospace}
.document-reader{background:var(--card)}
.document-content{padding:12px 18px 36px;font-size:16px;line-height:1.85;color:var(--ink-soft)}
.document-block{margin:9px 0;white-space:pre-wrap}
.document-heading{font-weight:650;font-size:18px;color:var(--ink);margin:26px 0 12px}
.document-heading:first-child{margin-top:4px}
.template-field{padding:8px 0;margin:10px 0;white-space:pre-wrap;line-height:2;color:var(--ink)}
.inline-answer{display:inline-block;position:relative;box-sizing:border-box;max-width:100%;min-width:72px;min-height:44px;padding:5px 8px;margin:4px 3px;background:transparent;color:var(--ink);vertical-align:middle;white-space:pre-wrap;word-break:break-word}
.inline-answer::after{content:"";position:absolute;left:3px;right:3px;bottom:5px;height:1px;background:var(--gold);pointer-events:none}
.inline-answer.answered{color:var(--ink)}
.template-field .inline-answer{vertical-align:bottom}
.current-field .inline-answer::after{height:2px;background:var(--red)}
.report+.report{margin-top:30px}
.report-title{font-size:21px;font-weight:650;margin:10px 0 0;color:var(--ink)}
.report-section+.report-section{border-top:1px solid var(--line)}
.writing-heading{display:flex;align-items:center;gap:8px;flex-shrink:0;min-height:52px;border-bottom:1px solid var(--line);padding:4px 8px}
.writing-heading button{min-width:52px;height:44px;color:var(--ink)}
.writing-title{flex:1;min-width:0;font-size:15px;font-weight:600;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.writing-area{flex:1;min-height:0;padding:16px 18px 0}
.long-answer{display:block;box-sizing:border-box;height:100%;width:100%;font-size:17px;line-height:1.9;color:var(--ink)}
.writing-footer{height:48px;min-height:48px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;border-top:1px solid var(--line)}
.writing-footer button{min-width:64px;height:44px;color:var(--ink-soft)}
.writing-footer text{font-size:12px;color:var(--ink-soft)}
.writing-footer .finish-writing{color:var(--red);font-weight:650}
.save-error{padding:7px 12px;font-size:12px;color:var(--red-dark);background:#f6e5df;flex-shrink:0}
.unavailable{flex:1;padding:30px;font-size:16px;line-height:1.8;color:var(--ink-soft)}
.panel-mask{position:absolute;z-index:30;inset:0;background:rgba(16,42,67,.4);display:flex;align-items:flex-end}
.panel{display:flex;flex-direction:column;width:100%;min-height:0;background:var(--card);color:var(--ink);box-sizing:border-box}
.full-panel{height:100%}
.panel-heading{height:52px;min-height:52px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border-bottom:1px solid var(--line);font-size:17px;font-weight:650}
.panel-heading button{height:44px;width:44px;font-size:27px;color:var(--ink-soft)}
.panel-body{flex:1;min-height:0;height:0;box-sizing:border-box;padding:0 18px 18px}
.info-title{font-size:22px;line-height:1.5;font-weight:650;margin:20px 0}
.info-description{font-size:16px;line-height:1.9;white-space:pre-wrap}
.info-section{font-size:18px;font-weight:600;margin:26px 0 12px}
.criterion{font-size:14px;line-height:1.8;margin-bottom:12px;color:var(--ink-soft)}
.points{margin-left:10px;color:var(--ink-soft);font-size:12px}
.material{margin:14px 0;font-size:14px;line-height:1.8}
.material .muted{font-size:12px}
.info-note{font-size:13px;line-height:1.8;padding:16px 0;margin-top:24px;color:var(--ink-soft);border-top:1px solid var(--line)}
.history-link{font-size:15px;color:var(--red);padding:18px 0}
.old-draft{font-size:14px;line-height:1.8;padding:12px;background:var(--paper);margin-bottom:14px}
.old-label{font-weight:600;margin:12px 0 6px}
.directory-row{display:flex!important;width:100%!important;min-height:62px;align-items:center;gap:12px;padding:14px 4px!important;text-align:left;border-bottom:1px solid var(--line)}
.directory-current{background:var(--paper-deep)!important}
.directory-number{font-size:13px;min-width:22px;color:var(--ink-soft)}
.directory-label{flex:1;min-width:0;font-size:14px;line-height:1.6}
.directory-status{font-size:12px;color:var(--ink-soft);white-space:nowrap}
.pre{white-space:pre-wrap;word-break:break-word}

.panel{padding-bottom:env(safe-area-inset-bottom)}

.workspace button{display:flex;align-items:center;justify-content:center;width:auto!important;flex-shrink:0}
.workspace-top .top-action{flex:0 0 52px}
.mode-switch{flex:0 1 204px;min-width:0}
.workspace .mode-switch button{flex:1;min-width:0;padding:0 5px;font-size:12px;white-space:nowrap}
.mode-label{white-space:nowrap;flex-shrink:0}
.writing-heading button{flex:0 0 52px}
.writing-footer text{white-space:nowrap}
.workspace .directory-row{width:100%!important;justify-content:flex-start}
.code-content,.code-blank,.code-answer{font-family:Consolas,Menlo,"PingFang SC","Microsoft YaHei",monospace}
.inline-answer{min-width:72px;padding-left:8px;padding-right:8px}


.reader-footer .reader-reference{height:38px;min-width:88px;padding:0 12px;border-radius:6px;background:var(--red);color:var(--card);font-weight:600}
.writing-heading button[data-action="reveal"]{flex-basis:76px;font-weight:600}
.workspace .completion{justify-content:flex-start;height:44px;font-size:12px;color:var(--ink-soft);white-space:nowrap}
.writing-context{flex-shrink:0;height:28%;max-height:180px;min-height:70px;box-sizing:border-box;padding:12px 18px;background:var(--paper);font-size:14px;line-height:1.8;color:var(--ink-soft)}
.writing-context-title{font-weight:600;margin-bottom:8px}
.directory-filters{display:flex;align-items:center;gap:6px;min-height:50px;padding:5px 12px;flex-shrink:0;border-bottom:1px solid var(--line)}
.directory-filters button{flex:1;height:38px;font-size:13px;border-radius:6px;color:var(--ink-soft)}
.directory-filters .selected{background:var(--paper-deep);color:var(--red);font-weight:600}
.directory-empty{padding:36px 0;text-align:center;font-size:15px;color:var(--ink-soft)}
.workspace-top .top-action{flex:0 0 44px;min-width:44px!important;font-size:13px}
.workspace-top .wrap-toggle{font-size:12px;color:var(--ink-soft)}
.reader-footer{gap:6px;padding:0 10px}
.workspace .reader-footer .completion{min-width:64px;font-size:11px}
.reader-footer .reader-reference{min-width:82px;height:44px;background:var(--paper-deep);color:var(--ink);padding:0 8px}
.reader-footer .website-action{min-width:100px;height:44px;padding:0 9px;border-radius:3px;background:var(--red);color:var(--card);font-size:13px;font-weight:600}
.code-comparison{box-sizing:border-box;width:100vw;max-width:100vw;padding:0 12px 0 35px}
.template-field answer-comparison,.report-section answer-comparison{display:block}

.syntax-keyword,.syntax-builtin{color:#008000}.syntax-keyword{font-weight:600}.syntax-string{color:#ba2121}.syntax-comment{color:#408080;font-style:italic}.syntax-number{color:#080}.syntax-operator{color:#7800c2}.syntax-definition{color:#00f}
.code-comparisons{position:sticky;left:0;max-width:100vw}
