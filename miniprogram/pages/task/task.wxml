<view wx:if="{{task}}" class="workspace {{mode === 'code' && !writing ? 'code-workspace' : ''}}" style="height:{{keyboardHeight ? viewportHeight + 'px' : '100vh'}};padding-bottom:{{safeBottom}}px">
  <view wx:if="{{!keyboardHeight && !writing}}" class="workspace-top">
    <button class="top-action" bindtap="openPanel" data-panel="info">题目</button>
    <view class="mode-switch" wx:if="{{codeFields.length && textFields.length}}"><button class="{{mode === 'code' ? 'selected' : ''}}" bindtap="switchMode" data-mode="code">代码 {{codeFilled}}/{{codeFields.length}}</button><button class="{{mode === 'document' ? 'selected' : ''}}" bindtap="switchMode" data-mode="document">{{task.group === '3.2' ? '流程' : '报告'}} {{textFilled}}/{{textFields.length}}</button></view>
    <text wx:else class="mode-label">{{mode === 'code' ? '代码练习' : document.template ? '文书填空' : '分析报告'}}</text>
    <button class="top-action" bindtap="openPanel" data-panel="directory">目录</button>
    <button wx:if="{{mode === 'code'}}" class="top-action wrap-toggle" bindtap="toggleWrap" aria-label="{{wrapCode ? '切换为横向查看代码' : '切换为代码自动换行'}}">{{wrapCode ? '横向' : '换行'}}</button>
  </view>
  <view wx:if="{{saveError}}" class="save-error">{{saveError}}</view>

  <block wx:if="{{writing}}">
    <view class="writing-heading"><button bindtap="done">‹ 返回</button><view class="writing-title">{{field.label}}</view><button bindtap="reveal" data-action="reveal">对比答案</button></view>
    <scroll-view wx:if="{{promptOpen}}" class="writing-context" scroll-y><view class="writing-context-title">{{task.title}}</view><view class="pre">{{field.context || task.description}}</view></scroll-view>
    <view class="writing-area"><textarea wx:if="{{!panel && !websiteOpen}}" class="long-answer" value="{{answer}}" focus="{{inputFocus}}" maxlength="10000" placeholder="写下你的分析与思路…" bindinput="input" bindkeyboardheightchange="keyboard" adjust-position="{{false}}" show-confirm-bar="{{false}}" /></view>
    <view class="writing-footer"><button bindtap="togglePrompt" data-action="toggle-prompt">{{promptOpen ? '收起题目' : '看题目'}}</button><text>{{savedLabel}}</text><button class="finish-writing" bindtap="done">完成</button></view>
  </block>
  <block wx:else>
    <scroll-view wx:if="{{mode === 'code' && codeAvailable}}" class="reader code-reader {{wrapCode ? 'wrapped' : 'unwrapped'}}" scroll-y scroll-x="{{!wrapCode}}" scroll-into-view="{{codeTarget}}" scroll-top="{{codeScroll}}" scroll-left="{{codeLeft}}" bindscroll="readerScroll" data-mode="code" show-scrollbar="{{false}}">
      <view class="code-content">
        <view wx:for="{{codeCells}}" wx:key="id" wx:for-item="cell">
          <view wx:if="{{codeCells.length > 1}}" class="cell-heading">{{cell.title}}</view>
          <block wx:for="{{cell.lines}}" wx:key="id" wx:for-item="line"><view id="{{line.id}}" class="code-line {{field.source.cellId === cell.id && field.source.line === line.number ? 'current-line' : ''}}">
            <text class="line-number">{{line.number}}</text>
            <view class="line-content"><block wx:for="{{line.tokens}}" wx:key="key" wx:for-item="token"><view wx:if="{{token.blank}}" class="code-blank {{token.index === current ? 'active-blank' : ''}} {{token.filled ? 'filled-blank' : ''}}" style="{{editing && token.index === current && !panel ? 'width:' + inlineWidth + 'px' : ''}}" data-index="{{token.index}}" bindtap="selectField"><textarea wx:if="{{editing && token.index === current && !panel && !websiteOpen}}" class="inline-editor code-answer" data-index="{{token.index}}" value="{{answers[token.id]}}" focus="{{inputFocus}}" auto-height maxlength="10000" aria-label="填写答案" bindinput="input" catchtap="swallow" bindkeyboardheightchange="keyboard" adjust-position="{{false}}" show-confirm-bar="{{false}}" /><text wx:else>{{token.text}}</text></view><text wx:else class="code-text"><text wx:for="{{token.parts}}" wx:for-item="part" wx:key="key" class="syntax-{{part.syntax}}">{{part.text}}</text></text></block></view>
          </view><view wx:if="{{revealed}}" class="code-comparisons"><block wx:for="{{line.tokens}}" wx:for-item="blank" wx:key="key"><view wx:if="{{blank.blank}}" id="comparison-{{blank.index}}" class="code-comparison"><answer-comparison class="inline-comparison" data-index="{{blank.index}}" reference="{{comparisons[blank.id]}}" /></view></block></view></block>
        </view>
      </view>
    </scroll-view>
    <view wx:elif="{{mode === 'code'}}" class="unavailable">这道题已更新，请更新小程序后继续。之前的填写可以在“题目”中查看。</view>
    <scroll-view wx:else class="reader document-reader" scroll-y scroll-into-view="{{documentTarget}}" scroll-top="{{documentScroll}}" bindscroll="readerScroll" data-mode="document" show-scrollbar="{{false}}">
      <view class="document-content">
        <block wx:if="{{document.template}}"><block wx:for="{{document.blocks}}" wx:key="id">
          <view wx:if="{{item.field}}" id="section-{{item.field.index}}" class="template-field {{current === item.field.index ? 'current-field' : ''}}"><text>{{item.before}}</text><view class="inline-answer {{answers[item.field.id] ? 'answered' : ''}}" style="{{editing && current === item.field.index && !panel ? 'width:' + inlineWidth + 'px' : ''}}" bindtap="selectField" data-index="{{item.field.index}}"><textarea wx:if="{{editing && current === item.field.index && !panel && !websiteOpen}}" class="inline-editor template-answer" data-index="{{item.field.index}}" value="{{answers[item.field.id]}}" focus="{{inputFocus}}" auto-height maxlength="10000" aria-label="填写答案" bindinput="input" catchtap="swallow" bindkeyboardheightchange="keyboard" adjust-position="{{false}}" show-confirm-bar="{{false}}" /><text wx:else>{{answers[item.field.id] || ''}}</text></view><text>{{item.after}}</text><view wx:if="{{revealed}}" id="comparison-{{item.field.index}}"><answer-comparison class="inline-comparison" data-index="{{item.field.index}}" reference="{{comparisons[item.field.id]}}" /></view></view>
          <view wx:else class="document-block {{item.kind === 'heading' ? 'document-heading' : ''}}">{{item.text}}</view>
        </block></block>
        <block wx:else><view wx:for="{{document.sections}}" wx:key="name" class="report"><view class="report-title">{{item.title}}</view><view wx:for="{{item.fields}}" wx:key="id" wx:for-item="entry" id="section-{{entry.index}}" class="report-section"><answer-field class="answer-field" data-index="{{entry.index}}" field="{{entry}}" comparing="{{revealed}}" value="{{answers[entry.id]}}" checked="{{checks[entry.id]}}" bind:activate="selectField" bind:compare="revealField" /><view wx:if="{{revealed}}" id="comparison-{{entry.index}}"><answer-comparison class="inline-comparison" data-index="{{entry.index}}" reference="{{comparisons[entry.id]}}" /></view></view></view></block>
      </view>
    </scroll-view>

    <view wx:if="{{editing}}" class="fill-toolbar">
      <button data-step="-1" bindtap="move" disabled="{{position === 0}}" aria-label="上一项">‹</button><button class="position" bindtap="openPanel" data-panel="directory" data-action="fill-directory" aria-label="填写目录">{{position + 1}}/{{fieldCount}} ⌄</button><button data-step="1" bindtap="move" disabled="{{position + 1 === fieldCount}}" aria-label="下一项">›</button><button class="reference-action" bindtap="reveal" data-action="reveal">{{revealed ? '收起对比' : '对比答案'}}</button><button class="done-action" bindtap="done" data-action="done">收起</button>
    </view>
    <view wx:else class="reader-footer"><button class="completion" bindtap="openRemaining" data-action="remaining">已填 {{filled}}/{{task.total}} ›</button><button class="reader-reference" bindtap="reveal" data-action="reveal">{{revealed ? '收起对比' : '对比答案'}}</button><button class="website-action" bindtap="openWebsite" data-action="open-website">{{mode === 'code' ? '去网页执行' : '网页实操'}} ↗</button></view>
  </block>

  <view wx:if="{{panel}}" class="panel-mask" bindtap="closePanel">
    <view class="panel full-panel" catchtap="swallow">
      <view class="panel-heading"><text>{{panel === 'info' ? '题目' : '填写目录'}}</text><button bindtap="closePanel" data-action="close-panel" aria-label="关闭">×</button></view>
      <view wx:if="{{panel === 'directory'}}" class="directory-filters"><button class="{{directoryFilter === 'all' ? 'selected' : ''}}" bindtap="changeDirectoryFilter" data-filter="all">全部 {{task.total}}</button><button class="{{directoryFilter === 'missing' ? 'selected' : ''}}" bindtap="changeDirectoryFilter" data-filter="missing">未填 {{remaining}}</button><button class="{{directoryFilter === 'review' ? 'selected' : ''}}" bindtap="changeDirectoryFilter" data-filter="review">需练习 {{needsReview}}</button></view>
      <scroll-view class="panel-body" scroll-y>
        <block wx:if="{{panel === 'info'}}">
          <view class="info-title">{{task.title}}</view><view class="info-description">{{task.description}}</view>
          <view class="info-section">评分要点</view><view class="criterion" wx:for="{{task.rubric}}" wx:key="id">{{item.description}}<text class="points">{{item.points}} 分</text></view>
          <block wx:if="{{task.materials.length}}"><view class="info-section">配套素材</view><view class="material" wx:for="{{task.materials}}" wx:key="name"><view>{{item.name}}</view><view class="muted">{{item.note}}</view></view></block>
          <view wx:if="{{older.length}}" class="history-link" bindtap="older" data-action="older">历史填写（{{older.length}}） {{showOlder ? '收起' : '查看'}}</view><block wx:if="{{showOlder}}"><view wx:for="{{older}}" wx:key="version" class="old-draft"><view wx:for="{{item.answers}}" wx:for-item="old" wx:key="id"><view class="old-label">{{old.label}}</view><view class="pre">{{old.answer}}</view></view></view></block>
          <view class="info-note">填写保存在这台设备上。需要运行代码时，在电脑访问 www.aitrainer3.xyz，找到 {{task.code}} 题。</view>
        </block>
        <block wx:elif="{{panel === 'directory'}}"><view wx:for="{{visibleDirectory}}" wx:key="id" class="directory-row {{current === item.index ? 'directory-current' : ''}}" data-index="{{item.index}}" data-locate="{{true}}" bindtap="selectField"><text class="directory-number">{{item.index + 1}}</text><text class="directory-label">{{item.label}}</text><button class="directory-status" data-index="{{item.index}}" catchtap="assessField">{{item.needsReview ? '需练习' : item.checked ? '已掌握' : item.filled ? '已填' : '待填'}} ⌄</button></view><view wx:if="{{!visibleDirectory.length}}" class="directory-empty">{{directoryFilter === 'missing' ? '本题已全部填写' : '还没有标记为需练习的项目'}}</view></block>
      </scroll-view>
    </view>
  </view>
</view>
<website-guide class="website-guide" visible="{{websiteOpen}}" code="{{task.code}}" executable="{{task.executable}}" bind:close="closeWebsite" />
