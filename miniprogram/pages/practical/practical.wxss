.practical-page{padding-top:28rpx}.search-box{display:flex;align-items:center;background:#fffef9;border:1rpx solid #ccd5c7;border-radius:14rpx;margin:28rpx 0 22rpx;padding:0 20rpx;min-height:94rpx}.search-box input{flex:1;min-width:0;font-size:27rpx}.search-box button{background:transparent;padding:0 10rpx;line-height:88rpx;font-size:24rpx;color:#245946}.recent{background:#e9efdf}.recent-footer{display:flex;justify-content:space-between;font-size:24rpx;color:#48674d;margin-top:12rpx}.module-section .section-title{margin:26rpx 0 14rpx;font-size:29rpx}.module-card{text-align:left;display:block;width:100%;padding:22rpx;background:#fffef9;border:1rpx solid #dde2d4;border-radius:18rpx;line-height:1.6;min-height:168rpx}.module-meta{font-size:21rpx;color:#778075}.module-name{font-size:28rpx;font-weight:600;margin:8rpx 0 14rpx;color:#25382f}.module-count{font-size:22rpx;color:#637b58}.arrow{float:right}.local-note{font-size:23rpx;color:#788075;margin:28rpx 0}.list-heading{display:flex;justify-content:space-between;align-items:center}.back{font-size:26rpx;color:#245946;background:transparent;line-height:88rpx;padding:0 12rpx 0 0}.task-list{background:#fffef9;border:1rpx solid #dfe4d8;border-radius:18rpx;overflow:hidden}.task-row{display:flex;align-items:flex-start;gap:18rpx;padding:26rpx 22rpx;border-bottom:1rpx solid #e7eadf}.task-row:last-child{border-bottom:0}.task-code{font-size:25rpx;color:#738969;flex-shrink:0;min-width:62rpx;padding-top:2rpx}.task-main{flex:1;min-width:0}.task-status{font-size:23rpx;color:#788075;margin-top:10rpx}.task-arrow{font-size:36rpx;color:#6e8267}
.back{display:inline-flex;justify-content:flex-start;width:auto!important;margin:0}
.module-section .grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.module-card{min-width:0;max-width:100%;box-sizing:border-box;white-space:normal}
