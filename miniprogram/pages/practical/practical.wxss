.practical-page{padding-top:28rpx}.search-box{display:flex;align-items:center;background:var(--card);border:1rpx solid var(--line);border-radius:6rpx;margin:28rpx 0 22rpx;padding:0 20rpx;min-height:94rpx}.search-box input{flex:1;min-width:0;font-size:27rpx}.search-box button{background:transparent;padding:0 10rpx;line-height:88rpx;font-size:24rpx;color:var(--red)}.recent{background:var(--paper-deep)}.recent-footer{display:flex;justify-content:space-between;font-size:24rpx;color:var(--ink-soft);margin-top:12rpx}.module-section .section-title{margin:26rpx 0 14rpx;font-size:29rpx}.module-card{text-align:left;display:block;width:100%;padding:22rpx;background:var(--card);border:1rpx solid var(--line);border-radius:6rpx;line-height:1.6;min-height:168rpx}.module-meta{font-size:21rpx;color:var(--ink-soft)}.module-name{font-size:28rpx;font-weight:600;margin:8rpx 0 14rpx;color:var(--ink)}.module-count{font-size:22rpx;color:var(--ink-soft)}.arrow{float:right}.local-note{font-size:23rpx;color:var(--ink-soft);margin:28rpx 0}.list-heading{display:flex;justify-content:space-between;align-items:center}.back{font-size:26rpx;color:var(--red);background:transparent;line-height:88rpx;padding:0 12rpx 0 0}.task-list{background:var(--card);border:1rpx solid var(--line);border-radius:6rpx;overflow:hidden}.task-row{display:flex;align-items:flex-start;gap:18rpx;padding:26rpx 22rpx;border-bottom:1rpx solid var(--line)}.task-row:last-child{border-bottom:0}.task-code{font-size:25rpx;color:var(--red);flex-shrink:0;min-width:62rpx;padding-top:2rpx}.task-main{flex:1;min-width:0}.task-status{font-size:23rpx;color:var(--ink-soft);margin-top:10rpx}.task-arrow{font-size:36rpx;color:var(--ink-soft)}
.back{display:inline-flex;justify-content:flex-start;width:auto!important;margin:0}
.module-section .grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.module-card{min-width:0;max-width:100%;box-sizing:border-box;white-space:normal}
.website-callout{margin:26rpx 0;padding:28rpx;background:var(--ink);color:var(--card);border:1rpx solid var(--ink);border-radius:6rpx}
.website-kicker{font-size:20rpx;color:#d7bb83;letter-spacing:1rpx}
.website-title{font-family:"Noto Serif SC",STSong,SimSun,serif;font-size:35rpx;font-weight:700;line-height:1.4;margin:12rpx 0}
.website-description{font-size:24rpx;line-height:1.8;color:#ced9e1}
.website-callout button{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;margin-top:22rpx;padding:12rpx 20rpx;background:var(--red);color:white;border-radius:4rpx;font-size:25rpx;font-weight:600;line-height:1.5;text-align:left}
