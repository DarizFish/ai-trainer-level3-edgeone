[Unit]
Description=AI Trainer Level 3 Next.js application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aitrainer
Group=aitrainer
WorkingDirectory=/srv/aitrainer/current
EnvironmentFile=/etc/aitrainer/aitrainer.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
# 整站共用这一个进程的连接池，和 EdgeOne「每个函数实例一条连接」完全不同：池子太小时
# 一次慢写入就会把其他用户的请求排在后面。lab 每 12 秒自动保存一次草稿，正文上限 4 MB，
# 且数据库在东京、源站在北京，慢写入是常态而不是异常。db/index.ts 允许到 20。
Environment=DATABASE_POOL_MAX=10
Environment=TRUSTED_CLIENT_IP_HEADER=x-real-ip
ExecStart=/opt/node/bin/node server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
SuccessExitStatus=143
UMask=0027
LimitNOFILE=65535

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
